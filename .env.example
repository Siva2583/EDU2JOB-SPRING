# ============================================================
# EDU2JOB 2.0 — environment template. Copy to .env / export these
# in your shell or deployment platform. NEVER commit real secrets.
# ============================================================

# --- Spring Boot / PostgreSQL ---
# Existing Neon/production database URL (keep pointing at the SAME
# database to preserve existing users and prediction history):
DATABASE_URL=jdbc:postgresql://localhost:5432/edu2job
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
# At least 32 random characters. Changing it invalidates existing tokens
# (users simply log in again; accounts are unaffected).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PORT=8080

# --- Spring Boot -> Flask ML service ---
FLASK_BASE_URL=http://localhost:5000
FLASK_CONNECT_TIMEOUT_MS=3000
FLASK_READ_TIMEOUT_MS=30000

# --- Flask ML service ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Folder with the NEW model artifacts (see edu2job-flask-ai/ml_models/README.md):
MODEL_DIR=ml_models/v2
MODEL_VERSION=edu2job-v2

# --- React (create edu2job-react-frontend/.env from this if needed) ---
# No secrets here — anything in a React env var is public.
REACT_APP_API_URL=http://localhost:8080
